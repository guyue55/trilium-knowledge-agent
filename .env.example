# ============================================
# Trilium Knowledge Agent 环境变量配置示例
# ============================================
# 使用方法：
# 1. 复制此文件为 .env：Linux/Mac 使用 cp .env.example .env；Windows 使用 copy .env.example .env
# 2. 根据你的实际环境修改下列配置项
# 3. 注意：.env 文件不应提交到版本控制系统
# ============================================

# ============================================
# Trilium Notes 配置
# ============================================

# Trilium Notes API 基础 URL
# 示例: http://localhost:8080 或 http://192.168.1.100:8080
TRILIUM_BASE_URL=http://localhost:8080

# Trilium Notes API Token
# 在 Trilium 中：设置 -> 选项 -> 同步 -> ETAPI Token -> 创建
# 提示：如果为空，将无法连接 Trilium
TRILIUM_TOKEN=your_trilium_api_token_here

# Trilium 数据目录（用于文件系统监控，可选）
TRILIUM_DATA_DIR=./data/trilium

# 需要导出的笔记 ID 列表（逗号分隔）
# 默认为 "root" 表示从根笔记开始导出所有子笔记
# 可以指定多个笔记ID，例如：root,note1,note2
TRILIUM_NOTE_IDS=root

# 导出深度限制（整数）
# 控制从根笔记开始的最大层级深度；建议值：10-20
TRILIUM_EXPORT_DEPTH=10

# 导出笔记数量限制（整数）
# 限制最多导出多少个笔记，防止内存溢出
# 建议值: 5000-20000（根据您的知识库大小调整）
TRILIUM_EXPORT_LIMIT=5000

# ============================================
# 向量数据库配置
# ============================================

# 向量数据库存储目录
# ChromaDB 将在此目录存储嵌入向量数据
VECTOR_DB_DIR=./data/vector_db/embeddings

# ============================================
# 嵌入模型配置
# ============================================

# 嵌入模型名称（HuggingFace 模型 ID）
# 用于将文本转换为向量表示
# 推荐模型: sentence-transformers/all-MiniLM-L6-v2 (轻量级，快速)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 嵌入模型本地存储路径
# 模型下载后将存储在此路径
EMBEDDING_MODEL_LOCAL_PATH=./data/models/sentence-transformers/all-MiniLM-L6-v2

# ============================================
# 语言模型 (LLM) 配置
# ============================================

# 语言模型类型
# 可选值: 
#   - gpt4all: 本地模型 (支持本地)
#   - qwen: 阿里云千问 (默认，支持本地和API)
#   - openai: OpenAI API 或兼容 API (如 DeepSeek, OneAPI)
LLM_MODEL_TYPE=qwen

# 是否使用 API 调用 (针对 qwen 类型，gpt4all 始终为 false，openai 始终为 true)
# 可选值: true, false
LLM_USE_API=false

# 语言模型路径（本地模型）
# GPT4All: 指向 .bin 模型文件
# Qwen: 指向模型目录（包含 config.json 等文件）
LLM_MODEL_PATH=./data/models/gpt4all/ggml-gpt4all-j-v1.3-groovy.bin

# 阿里云千问 API 密钥 (仅在 LLM_MODEL_TYPE=qwen 且 LLM_USE_API=true 时需要)
QWEN_API_KEY=

# OpenAI 配置 (仅在 LLM_MODEL_TYPE=openai 时需要)
# 支持 OpenAI 官方 API 或任何兼容 OpenAI 协议的第三方 API
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo

# ============================================
# 安全与认证配置
# ============================================

# API 访问密钥（可选）
# 如果设置，前端请求必须在 Header 中包含 X-API-Key: your_auth_key
# 建议在生产环境或公共服务器部署时开启
API_AUTH_KEY=

# ============================================
# 检索配置
# ============================================

# 检索时返回的相关文档数量（整数）
# 建议值: 5-20（数量越大，答案可能越准确，但处理时间也越长）
SEARCH_K=10

# 文本切片大小
CHUNK_SIZE=800

# 文本切片重叠大小
CHUNK_OVERLAP=150

# ============================================
# 重排序模型配置 (Reranker)
# ============================================

# 是否启用重排模型以提升检索质量
USE_RERANKER=true

# Reranker 模型名称
RERANKER_MODEL=BAAI/bge-reranker-base

# Reranker 模型本地存储路径
RERANKER_MODEL_LOCAL_PATH=./data/models/BAAI/bge-reranker-base

# Reranker 过滤后的 Top K 数量
RERANKER_TOP_K=5

# ============================================
# HuggingFace 镜像源配置
# ============================================

# HuggingFace 模型下载镜像源（可选）
# 中国大用户建议使用镜像源以加速下载
# 可选值: 
#   - https://hf-mirror.com (推荐，国内镜像)
#   - https://huggingface.co (官方源)
HF_ENDPOINT=https://hf-mirror.com
