# Trilium配置
TRILIUM_BASE_URL=http://localhost:8080
TRILIUM_TOKEN=your_api_token_here
TRILIUM_DATA_DIR=./data/trilium
NOTE_IDS=root

# 向量数据库配置
VECTOR_DB_DIR=./data/vector_db/embeddings

# 嵌入模型配置
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_LOCAL_PATH=./data/models/sentence-transformers/all-MiniLM-L6-v2

# 语言模型配置
LLM_MODEL_PATH=./data/models/qwen/Qwen1.5-1.8B-Chat
LLM_MODEL_TYPE=qwen  # gpt4all 或 qwen
QWEN_API_KEY=your_qwen_api_key_here  # 阿里云千问API密钥

# 检索配置
SEARCH_K=10

# 镜像源配置（主要用于模型下载）
HF_ENDPOINT=https://hf-mirror.com

# 解决huggingface_hub导入问题
HF_HUB_OFFLINE=0