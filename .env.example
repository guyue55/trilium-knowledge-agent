# ============================================
# Trilium Knowledge Agent 环境变量配置示例 (第三期极致体验重构版)
# ============================================
# 使用方法：
# 1. 复制此文件为 .env：Linux/Mac 使用 cp .env.example .env；Windows 使用 copy .env.example .env
# 2. 根据你的实际环境修改下列配置项
# 3. 注意：.env 文件不应提交到版本控制系统
# ============================================

# ============================================
# Trilium Notes 配置
# ============================================

# Trilium Notes API 基础 URL (即您的 Trilium 网页版访问路径)
# 示例: http://localhost:8080 或 http://192.168.1.100:8080
TRILIUM_BASE_URL=http://localhost:8080

# Trilium Notes API Token
# 在 Trilium 中获取：设置(Settings) -> 选项(Options) -> 同步(Sync) -> ETAPI Token -> 创建(Create)
# 提示：如果为空，将无法连接 Trilium
TRILIUM_TOKEN=your_trilium_api_token_here

# Trilium 数据下载目录（用于数据备份，可选）
TRILIUM_DATA_DIR=./data/trilium

# 需要导入并检索的根笔记 ID 列表（逗号分隔）
# 默认为 "root" 表示从根笔记开始递归同步所有笔记。
# 可以指定特定子树的笔记ID，例如：root,note1,note2
TRILIUM_NOTE_IDS=root

# 笔记最大递归同步深度（整数，防陷入无限死循环）
# 建议值：10-20
TRILIUM_EXPORT_DEPTH=10

# 同步笔记的最大数量上限（整数）
# 限制最多同步多少个笔记，防止内存溢出；
# 建议值: 5000-20000（根据您的实际知识库大小微调）
TRILIUM_EXPORT_LIMIT=5000


# ============================================
# 向量数据库与本地搜索引擎配置
# ============================================

# 向量数据库（LanceDB）物理存储路径
# 采用绝对化自适应，无论从哪个目录拉起，均唯一指向该目录，永不分裂
VECTOR_DB_DIR=./data/vector_db/embeddings


# ============================================
# 嵌入模型配置 (Embeddings)
# ============================================

# 嵌入模型名称（基于 FastEmbed）
# 默认使用专为中文检索优化的极速轻量级模型：BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 嵌入模型本地高速缓存路径
EMBEDDING_MODEL_LOCAL_PATH=./data/models/fastembed


# ============================================
# 语言模型 (LLM) 编排配置
# ============================================

# 语言模型类型
# 可选值: 
#   - ollama: 本地极速免费模型首选！(配合 Ollama 客户端，支持本地完全离线和绝对隐私)
#   - deepseek: 当前 2026 最主流、性价比天花板、对中文支持极强的云端模型！
#   - gemini: 具有超级长上下文和无缝逻辑解析的多模态之王！
#   - openai: OpenAI 官方 API 或者中转 API 兼容
#   - qwen: 阿里云通义千问 API 兼容
LLM_MODEL_TYPE=ollama

# -----------------
# 1. Ollama 配置 (LLM_MODEL_TYPE=ollama)
# -----------------
# Ollama 客户端本地模型名称 (如 qwen2:7b, qwen2.5:7b, llama3 等，默认 qwen2:7b)
LLM_MODEL_PATH=qwen2:7b

# -----------------
# 2. DeepSeek 配置 (LLM_MODEL_TYPE=deepseek)
# -----------------
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# -----------------
# 3. Gemini 配置 (LLM_MODEL_TYPE=gemini)
# -----------------
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# -----------------
# 4. OpenAI 传统配置 (LLM_MODEL_TYPE=openai)
# -----------------
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo


# ============================================
# 安全、认证与授权配置
# ============================================

# 全局 API 访问验证密钥（安全认证）
# 1. 留空（默认）：在【本地非 Docker 环境】下表示免密钥免验证访问，开箱即用，极佳的个人本地体验。
# 2. 自动生成（自愈安全）：在【Docker / 容器部署环境】下，如果留空，系统为了防止端口对外裸奔暴露，会在服务启动时自动生成随机安全 Token 并高亮输出在后端日志中，您需要将该 Token 复制到前端界面底部的 [Auth Token] 输入框方可正常使用。
# 3. 手动配置：填入自定义密钥，前端请求接口时必须在头部携带对应的 X-API-Key (或在界面底部输入)。
API_AUTH_KEY=


# ============================================
# RAG 高级检索及切片配置
# ============================================

# 检索时返回的初始候选文档块数量 (用于 RRF 双路混合搜索的初筛召回，越大越准但耗时稍高)
SEARCH_K=10

# 文本智能切片的分块大小 (字符)
CHUNK_SIZE=800

# 文本切片的重叠跨度 (overlap 字符数)
CHUNK_OVERLAP=150


# ============================================
# 重排序模型配置 (Reranker)
# ============================================

# 是否启用 ONNX 极速重排模型以深度二次优化检索精度
USE_RERANKER=true

# 重排模型名称 (基于 FastEmbed 交叉编码器)
# 默认使用超轻量（仅 80MB）且推理极速、下载稳定的 ONNX 模型：Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# 重排模型物理缓存路径
RERANKER_MODEL_LOCAL_PATH=./data/models/Xenova/ms-marco-MiniLM-L-6-v2

# 重排后的 Top K 输出数量 (即最终送到 LLM 作为参考上下文的切片数)
RERANKER_TOP_K=5

# 重排分数过滤阈值 (低于此分数的候选块将被过滤掉，建议 Xenova 模型设为 -5.0 到 -2.0；默认为 0.0)
RERANKER_THRESHOLD=0.0


# ============================================
# HuggingFace 高速国内镜像
# ============================================

# 模型下载的高清镜像（专为国内环境优化，默认开启以防拉取模型超时崩溃）
HF_ENDPOINT=https://hf-mirror.com
